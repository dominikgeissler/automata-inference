var R;
var X;

// A customer is of low-risk with probability 9/10
{ R := 0 } [9/10] { R := 1 };

// A high-risk customer files on average twice the number of claims
if (R = 0) {
    X += NegBinom(1, 1/2);
} else {
    X += NegBinom(2, 1/2);
}
// We have filed at least 2 claims
observe(X >= 2);

?E[X, 2]